# .env.example — Plico environment variables
# Copy to .env and customize as needed.
# All variables have sensible defaults; none are required for basic operation.

# --- Network ---
# PLICO_HOST=127.0.0.1
# PLICO_DAEMON_PORT=7878
# PLICO_SSE_PORT=7879

# --- Inference Backend ---
# Embedding backend: "openai" (default), "ollama", "stub" (for testing)
# EMBEDDING_BACKEND=openai

# LLM backend: "llama" (default), "ollama", "stub" (for testing)
# LLM_BACKEND=llama

# --- Server URLs (auto-detected if not set) ---
# Priority: LLAMA_URL env > OPENAI_API_BASE env > ~/.plico/llama.url file > ps auto-detect > :8080
# LLAMA_URL=http://127.0.0.1:8080
# OPENAI_API_BASE=http://127.0.0.1:8080
# EMBEDDING_API_BASE=http://127.0.0.1:18921

# --- Model ---
# LLAMA_MODEL=qwen2.5-coder-7b-instruct
# EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# --- Knowledge Graph ---
# PLICO_KG_AUTO_EXTRACT=true

# --- Logging ---
# RUST_LOG=plico=info
# RUST_LOG=plico=debug

# --- Benchmark ---
# PREPROCESS_TIMEOUT=180
