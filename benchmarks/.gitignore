# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# uv
.venv/

# Local dataset payloads (source loaders under src/ must remain trackable)
/datasets/

# Build metadata is generated by packaging tools
/src/*.egg-info/

# Run artifacts are local evidence. Only the placeholder is tracked.
/results/**
!/results/.gitkeep

# Local execution evidence and logs
*.log
*.journal

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
